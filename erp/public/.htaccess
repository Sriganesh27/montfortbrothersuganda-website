<IfModule mod_rewrite.c>
    # 1. Disable MultiViews (This fixes the 404 conflict with admin.php)
    Options -MultiViews -Indexes
    
    RewriteEngine On

    # 2. Allow actual images, CSS, JS, and PDFs to load normally
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Force EVERYTHING else to go directly to your MVC Router
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
USE montfortug;
SET FOREIGN_KEY_CHECKS = 0;

-- 1. DROP EXISTING TABLES
DROP TABLE IF EXISTS erp_student_accounts, erp_academichistory, erp_parents, 
                     erp_enrollment, erp_students, erp_enrollmenthistory, 
                     erp_alumni, erp_users, erp_branches;

-- 2. CREATE BRANCHES
CREATE TABLE erp_branches (
    branch_id INT PRIMARY KEY AUTO_INCREMENT,
    branch_name VARCHAR(255) NOT NULL,
    school_code VARCHAR(10),
    branch_type VARCHAR(50),
    branch_location VARCHAR(255)
) ENGINE=InnoDB;

